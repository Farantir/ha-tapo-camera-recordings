{
  "tasks": {
    "dev": "deno run --allow-read=tapo,web,tags --allow-env --allow-net --watch=server/ server/main.ts",
    "start": "deno run --allow-read=tapo,web,tags --allow-env --allow-net server/main.ts",
    "check": "deno check server/*.ts web/*_test.ts",
    "fmt": "deno fmt",
    "lint": "deno lint",
    "test": "deno test --allow-read --allow-write --allow-env"
  },
  "imports": {
    "@std/http/file-server": "jsr:@std/http@1/file-server"
  },
  "fmt": { "lineWidth": 100, "exclude": ["tapo"] },
  "lint": { "exclude": ["tapo"], "rules": { "tags": ["recommended"] } }
}
