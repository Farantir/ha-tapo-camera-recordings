# Copy to .env and adjust. In Portainer, set these in the stack's
# "Environment variables" section instead of committing a .env file.

# --- host side -------------------------------------------------------------
# Your tapo backup folder on the Docker host, mounted read-only at /data.
TAPO_HOST_PATH=/volume1/tapo
# Published port. Careful: 8123 is also Home Assistant's default port.
HTTP_PORT=8123
# Interface to publish on. Narrow this to a LAN address if the host faces the
# internet, even with AUTH_PASSWORD set.
BIND_ADDRESS=0.0.0.0
CONTAINER_NAME=tapo-viewer
# uid:gid the container runs as. The bind mount keeps its host ownership, so
# this user has to be able to read TAPO_HOST_PATH — check with
#   ls -ldn <TAPO_HOST_PATH>
# and put the two numbers here. 1000:1000 is the image's own deno user.
PUID=1000
PGID=1000
RESTART_POLICY=unless-stopped

# --- app side --------------------------------------------------------------
# Timezone used for day/hour bucketing.
DISPLAY_TZ=Europe/Berlin
# Correction applied to filename timestamps; see server/config.ts.
TS_OFFSET_SECONDS=-3600
# Seconds between background rescans.
RESCAN_INTERVAL_S=1800

# --- authentication -------------------------------------------------------
# One shared password for the whole viewer. Leave it empty and there is no
# login at all — anyone who can reach the port sees the recordings.
AUTH_PASSWORD=
# How long a login lasts, in seconds. 43200 = 12 hours. A session that is
# still being used past its halfway point is renewed automatically.
SESSION_TTL_S=43200
# Key the session cookie is signed with. Empty means a fresh random key on
# every start, so a restart logs everyone out. Set it to any long random
# string to keep sessions alive across restarts:
#   openssl rand -base64 32
AUTH_SECRET=
