# Copy to .env and adjust. In Portainer, set these in the stack's
# "Environment variables" section instead of committing a .env file.

# --- host side -------------------------------------------------------------
# Your tapo backup folder on the Docker host, mounted read-only at /data.
TAPO_HOST_PATH=/volume1/tapo
# Published port. Careful: 8123 is also Home Assistant's default port.
HTTP_PORT=8123
# Interface to publish on. Narrow this to a LAN address if the host faces the
# internet, even with AUTH_PASSWORD set.
BIND_ADDRESS=0.0.0.0
CONTAINER_NAME=tapo-viewer
# uid:gid the container runs as. The bind mount keeps its host ownership, so
# this user has to be able to read TAPO_HOST_PATH — check with
#   ls -ldn <TAPO_HOST_PATH>
# and put the two numbers here. 1000:1000 is the image's own deno user.
PUID=1000
PGID=1000
RESTART_POLICY=unless-stopped

# --- app side --------------------------------------------------------------
# Timezone used for day/hour bucketing.
DISPLAY_TZ=Europe/Berlin
# Correction applied to filename timestamps; see server/config.ts.
TS_OFFSET_SECONDS=-3600
# Seconds between background rescans.
RESCAN_INTERVAL_S=1800

# --- authentication -------------------------------------------------------
# One shared password for the whole viewer. Leave it empty and there is no
# login at all — anyone who can reach the port sees the recordings.
AUTH_PASSWORD=
# How long a login lasts, in seconds. 43200 = 12 hours. A session that is
# still being used past its halfway point is renewed automatically.
SESSION_TTL_S=43200
# Key the session cookie is signed with. Empty means a fresh random key on
# every start, so a restart logs everyone out. Set it to any long random
# string to keep sessions alive across restarts:
#   openssl rand -base64 32
AUTH_SECRET=

# ---------------------------------------------------------------------------
# Event tagging (the optional tapo-tagger service)
# ---------------------------------------------------------------------------

# Where the viewer looks for the tagger's output. Both containers share the
# "tags" volume; the viewer mounts it read-only. Leave empty to turn tags off
# entirely — the filter chips then simply do not appear.
# TAGS_FILE=/tags/tags.json

# How often the tagger re-checks for new recordings, in seconds. 0 means run a
# single pass and exit. With a few new clips a day, hourly is plenty.
# TAGGER_INTERVAL_S=3600

# Detector size, trading accuracy against time per clip:
#   yolov10n   9 MB   fastest, weakest on small/distant animals
#   yolov10s  32 MB
#   yolov10m  64 MB
#   yolov10x 118 MB   default; clearly best on blurred garden wildlife
# On a low-powered box start with yolov10n for the first backfill, then switch
# up and delete tags.json to re-run at full quality.
# TAGGER_DETECTOR=yolov10x

# Frames per clip given to the detector. A subject can be present for two
# seconds of a sixty-second clip, so this is the main recall knob.
# TAGGER_MAX_FRAMES=24

# Half of those frames go to the busiest moments of the clip; this is the
# minimum distance between two of them, in seconds. Motion rises and falls
# smoothly, so with no gap the "busiest" frames are all the same second and
# half the budget is spent looking at one moment twelve times.
# TAGGER_PEAK_GAP_S=2.0

# Probability a taxon needs before the tag descends to it. Lower produces more
# species names and more mistakes; higher leaves more events at "animal" or a
# family name like "cat family".
# TAGGER_SPECIES_CONF=0.55

# How eager the tagger is to call a clip an event rather than no_event.
# Between them these four are the dial to turn when real visitors are coming
# back as "no event"; lower catches more brief, distant and blurred subjects at
# the cost of the occasional branch tagged as wildlife.
#
#   DETECT_CONF            a box must score this before it is looked at at all
#   TRUST_DETECTOR         above this the detector's own class stands even when
#                          the species classifier calls the crop blank — which
#                          it does for people in infrared and for cars
#   STRONG_SCORE           a single frame is enough for a person or a vehicle
#   STRONG_SCORE_WILDLIFE  the same for an animal, held higher on purpose
#
# Changing these re-tags nothing by itself; delete tags.json to re-run.
# TAGGER_DETECT_CONF=0.25
# TAGGER_TRUST_DETECTOR=0.35
# TAGGER_STRONG_SCORE=0.45
# TAGGER_STRONG_SCORE_WILDLIFE=0.75

# ONNX Runtime threads. Cap this on a small box so tagging does not starve the
# viewer; 0 lets the runtime decide.
# TAGGER_THREADS=0

# TAGGER_CONTAINER_NAME=tapo-tagger
# TAGGER_RESTART_POLICY=unless-stopped
# TAGGER_LOG_LEVEL=INFO
